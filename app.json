{
  "expo": {
    "name": "Oiconomos",
    "slug": "oiconomos-mobile-app",
    "version": "1.0.4",
    "orientation": "portrait",
    "owner": "oiconomos",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/c960cc41-49de-4b46-b620-42a8c63d76b5"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.oiconomos.www",
      "versionCode": 5
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c960cc41-49de-4b46-b620-42a8c63d76b5"
      }
    },
    "plugins": [
      "expo-community-flipper"
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
